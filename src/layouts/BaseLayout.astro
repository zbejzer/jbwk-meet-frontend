---
// BaseLayout.astro — HTML shell used by all pages.
// Provides: <html>, <head> with fonts & meta, global resets, custom properties.

import { PAGE } from '@data/meet'

// Global reset & theme
import '@assets/styles/global.css'
---

<!doctype html>
<html lang="pl">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{PAGE.title}</title>
        <meta name="description" content={PAGE.description} />

        <link rel="icon" type="image/webp" href="/favicon.webp" />

        <!-- Fonts: Jockey One (display) -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Jockey+One&display=swap"
            rel="stylesheet"
        />

        <style is:global>
            body {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            main {
                flex: 1;
            }
        </style>
    </head>
    <body>
        <slot />
    </body>
</html>
