---
// Button.astro — Reusable CTA / link button
// Props:
//   href: string          — link destination
//   variant?: 'primary' | 'secondary'  — default: 'primary'
//   class?: string        — additional CSS classes
//
// Slots:
//   default — button label (overrides label prop if both provided)

interface Props {
    href: string
    variant?: 'primary' | 'secondary'
    class?: string
}

const { href, variant = 'primary', class: extraClass = '' } = Astro.props
const isPrimary = variant === 'primary'
---

<a
    href={href}
    class={`btn ${isPrimary ? 'btn--primary' : 'btn--secondary'} ${extraClass}`}
    {...href.startsWith('http')
        ? { target: '_blank', rel: 'noopener noreferrer' }
        : {}}
>
    <slot />
</a>

<style>
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        font-family: var(--font-display);
        font-size: var(--text-lg);
        font-weight: 400;
        letter-spacing: var(--tracking-wide);
        line-height: 1;
        padding: var(--space-4) var(--space-6);
        border-radius: var(--radius-lg);
        border: 1px solid transparent;
        cursor: pointer;
        text-decoration: none;
        text-align: center;
        transition:
            background var(--duration-fast) var(--ease-out),
            transform var(--duration-fast) var(--ease-out),
            box-shadow var(--duration-fast) var(--ease-out);
        user-select: none;
        white-space: nowrap;
    }

    .btn:hover {
        transform: translateY(-1px);
    }

    .btn:active {
        transform: translateY(0);
    }

    /* ── Primary variant ────────────────────────────── */
    .btn--primary {
        background: var(--color-red);
        color: var(--color-white);
        border-color: rgba(255, 255, 255, 0.15);
        box-shadow: 0 4px 16px rgba(237, 57, 55, 0.3);
    }

    .btn--primary:hover {
        background: var(--color-red-muted);
        box-shadow: 0 6px 24px #ed393766;
    }

    /* ── Secondary variant ──────────────────────────── */
    .btn--secondary {
        background: rgba(255, 255, 255, 0.06);
        color: var(--color-white);
        border-color: var(--color-white-border-strong);
    }

    .btn--secondary:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.25);
    }

    /* ── Responsive ─────────────────────────────────── */
    @media (max-width: 719px) {
        .btn {
            font-size: var(--text-base);
            padding: var(--space-3) var(--space-5);
            width: 100%;
        }
    }
</style>
