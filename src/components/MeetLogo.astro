---
// MeetLogo.astro — JBWK Meet logo, reused in header, hero, and footer
// Props:
//   variant?: 'default' | 'compact'  — default shows "JBWK MEET", compact for navbar
//   size?: 'sm' | 'md' | 'lg'        — scale preset (default: 'md')
//   class?: string                    — additional CSS classes
//
// Renders stylized text (Jockey One) matching the preview.html logo design.
// Can be swapped for an inline SVG later without changing consumers.

interface Props {
    variant?: 'default' | 'compact'
    size?: 'sm' | 'md' | 'lg'
    class?: string
}

const { variant = 'default', size = 'md', class: extraClass = '' } = Astro.props
const isCompact = variant === 'compact'
---

<div
    class={`meet-logo meet-logo--${size} ${isCompact ? 'meet-logo--compact' : ''} ${extraClass}`}
    aria-label="JBWK Meet"
>
    <span class="meet-logo__jbwk">JBWK</span>
    {!isCompact && <span class="meet-logo__meet">MEET</span>}
</div>

<style>
    .meet-logo {
        display: flex;
        align-items: baseline;
        font-family: var(--font-display);
        line-height: 1;
        letter-spacing: var(--tracking-tight);
        color: var(--color-white);
        user-select: none;
    }

    .meet-logo__jbwk {
        color: var(--color-red);
    }

    .meet-logo__meet {
        color: var(--color-white);
        opacity: 0.85;
    }

    /* ── Default variant: two-line stacked ──────────── */
    .meet-logo:not(.meet-logo--compact) {
        flex-direction: column;
        gap: 0;
    }

    /* ── Compact variant: single line, navbar ────────── */
    .meet-logo--compact {
        flex-direction: row;
        gap: 0.35em;
    }

    /* ── Size presets ────────────────────────────────── */
    .meet-logo--sm {
        font-size: 1rem;
    }

    .meet-logo--md {
        font-size: clamp(1.5rem, 3vw, 2.25rem);
    }

    .meet-logo--lg {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
    }
</style>
