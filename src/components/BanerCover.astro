---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
    alignRight?: boolean
    imageUrl: string | ImageMetadata
}

const { alignRight = false, imageUrl } = Astro.props
---

<div
    class:list={[
        'flex',
        'flex-col-reverse',
        'md:align-stretch',
        'h-full',
        'w-full',
        'items-stretch',
        alignRight ? 'md:flex-row-reverse' : 'md:flex-row',
    ]}
>
    <div
        class="bg-gray-dark flex flex-col items-center justify-center gap-6 py-14 text-center md:py-24"
    >
        <slot />
    </div>
    <div class="2xl:grow-0">
        <Image src={imageUrl} alt="" class="h-full w-full object-cover" />
    </div>
</div>
