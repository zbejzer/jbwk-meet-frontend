---
// SiteHeader.astro — Sticky navbar with Alpine.js scroll detection.
// Used by all pages. Contains MeetLogo, nav links, and CTA button.

import { NAV_LINKS, NAV_CTA } from '@data/meet'
import MeetLogo from '@components/MeetLogo.astro'
import Button from '@components/Button.astro'
---

<header
    class="site-header"
    x-data="{ scrolled: false }"
    @scroll.window="scrolled = window.scrollY > 50"
    :class="{ 'site-header--scrolled': scrolled }"
>
    <div class="site-header__inner">
        <!-- Logo -->
        <a href="/" class="site-header__logo" aria-label="JBWK Meet — strona główna">
            <MeetLogo variant="compact" size="sm" />
        </a>

        <!-- Desktop nav links -->
        <nav class="site-header__nav" aria-label="Nawigacja główna">
            {
                NAV_LINKS.map((link) => (
                    <a href={link.href} class="site-header__link">
                        {link.label}
                    </a>
                ))
            }
        </nav>

        <!-- CTA button -->
        <div class="site-header__cta">
            <Button href={NAV_CTA.href} variant="primary">
                {NAV_CTA.label}
            </Button>
        </div>
    </div>
</header>

<style>
    .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        height: 68px;
        display: flex;
        align-items: center;
        background: transparent;
        border-bottom: 1px solid transparent;
        transition:
            background var(--duration-normal) var(--ease-out),
            border-color var(--duration-normal) var(--ease-out),
            box-shadow var(--duration-normal) var(--ease-out);
    }

    .site-header--scrolled {
        background: oklch(0.1451 0 0 / 0.97);
        border-bottom-color: var(--color-white-border);
        box-shadow: var(--shadow-md);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .site-header__inner {
        width: 100%;
        max-width: var(--content-max-width);
        margin: 0 auto;
        padding: 0 var(--space-6);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-8);
    }

    .site-header__logo {
        display: flex;
        align-items: center;
        text-decoration: none;
        flex-shrink: 0;
    }

    .site-header__nav {
        display: flex;
        align-items: center;
        gap: var(--space-6);
    }

    .site-header__link {
        font-family: var(--font-display);
        font-size: var(--text-sm);
        letter-spacing: var(--tracking-wide);
        color: var(--color-white-muted);
        text-decoration: none;
        text-transform: uppercase;
        transition: color var(--duration-fast) var(--ease-out);
        white-space: nowrap;
    }

    .site-header__link:hover {
        color: var(--color-white);
    }

    .site-header__cta {
        flex-shrink: 0;
    }

    /* Tablet: hide nav links, keep logo + CTA */
    @media (max-width: 1023px) {
        .site-header__nav {
            display: none;
        }
    }

    /* Mobile: compact padding */
    @media (max-width: 719px) {
        .site-header__inner {
            padding: 0 var(--space-4);
        }
    }
</style>