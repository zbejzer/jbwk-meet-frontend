---
// SiteFooter.astro — Shared page footer, used by all pages.
// Layout: logo + description left, social links + email + copyright right.
// Reads all text content from src/data/meet.ts.

import { FOOTER } from '@data/meet'
import { NAV_LINKS } from '@data/meet'
import { Image } from 'astro:assets'
import meetLogo from '@assets/images/jbwk-meet-logo.svg'

const currentYear = new Date().getFullYear()
const copyright = `© ${currentYear}`
---

<footer class="site-footer">
    <div class="site-footer__inner content-container">
        <!-- Logo + description -->
        <div class="site-footer__brand">
            <div class="site-footer__brand-logo-container">
                <Image
                    src={meetLogo}
                    alt="Logo JBWK Meet"
                    class="site-footer__brand-logo"
                />
            </div>
            <p class="site-footer__brand-desc">{FOOTER.description}</p>
        </div>

        <nav class="site-footer__links-section">
            <!-- <span class="site-footer__links-section-heading"
                >{FOOTER.navLinksLabel}</span
            >
            {
                NAV_LINKS.map((link) => (
                    <a
                        href={link.href}
                        class="site-footer__link"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {link.label}
                    </a>
                ))
            } -->
        </nav>
        <nav class="site-footer__links-section">
            <!-- <span class="site-footer__links-section-heading"
                >{FOOTER.metaLinksLabel}</span
            > -->
        </nav>
        <nav class="site-footer__links-section" aria-label="Social media">
            <span class="site-footer__links-section-heading"
                >{FOOTER.socialLinksLabel}</span
            >
            {
                FOOTER.socialLinks.map((link) => (
                    <a
                        href={link.href}
                        class="site-footer__link"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>
    </div>
    <div class="site-copyright content-container">
        <span class="site-copyright__notice">
            <span>{copyright}</span>
            <span>JBWK</span>
            <span>·</span>
            <span>{FOOTER.copyright}</span>
        </span>
        <span>Jak będzie w klawiaturach?</span>
    </div>
</footer>

<style>
    .site-footer {
        background: var(--color-black-950);
        border-top: 1px solid var(--color-white-border);
        padding: 48px 0px 36px;
        font-family: var(--font-jockey-one);
        font-size: var(--text-xs);
    }

    .site-footer__inner {
        display: grid;
        padding: 0px 48px;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: 40px;
        align-items: start;
        margin: 0px auto 32px;
    }

    .site-footer__brand {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }
    .site-footer__brand-logo {
        display: block;
        object-fit: contain;
        height: 100%;
        width: auto;
    }

    .site-footer__brand-logo-container {
        font-size: var(--text-xl);
        height: 1lh;
    }

    .site-footer__brand-desc {
        color: var(--color-white-35);
        line-height: var(--leading-relaxed);
        width: 70%;
        font-size: var(--text-sm);
    }

    .site-footer__links-section {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
    }

    .site-footer__links-section > * {
        display: block;
        letter-spacing: var(--tracking-wide);
    }

    .site-footer__links-section-heading {
        color: var(--color-white-35);
        margin-bottom: 14px;
        text-transform: uppercase;
    }

    .site-footer__link {
        color: var(--color-white-55);
        letter-spacing: 0.04em;
        padding: 4px 0px;
        text-decoration: none;
        transition: color var(--duration-fast) var(--ease-out);
    }

    .site-footer__link:hover {
        color: var(--color-white);
    }

    .site-copyright {
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-wider);
        color: oklch(from var(--color-white) l c h / 0.35);
        padding: 24px 48px 0px;
        border-top: 1px solid oklch(from var(--color-white) l c h / 0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        text-transform: uppercase;
    }

    .site-copyright__notice {
        display: inline-flex;
        flex-wrap: nowrap;
        gap: 0.25em;
    }

    /* Tablet / Mobile: single column stack */
    @media (max-width: 719px) {
        .site-footer__inner {
            grid-template-columns: 1fr;
            gap: var(--space-12);
            text-align: center;
        }

        .site-footer__brand {
            align-items: center;
        }

        .site-footer__meta {
            align-items: center;
            text-align: center;
        }
    }
</style>
