---
// PdfViewer.astro — Client-side PDF viewer using PDF.js from CDN.
// Props:
//   pdfUrl: string — path to the PDF file (relative to site root, served from /public/)

import '@assets/styles/cta-button.css'

interface Props {
    pdfUrl: string
}

const { pdfUrl } = Astro.props
---

<!-- Canvas container -->
<object data={pdfUrl} type="application/pdf" class="pdf-viewer">
    <div class="pdf-viewer__error">
        <div class="pdf-viewer__error-desc">
            <p>Nie udało się załadować dokumentu PDF.</p>
            <p>Spróbuj odświeżyć stronę lub pobrać plik.</p>
        </div>
        <a
            href={pdfUrl}
            class="btn btn--primary btn--cta pdf-viewer__error-btn"
            target="_blank"
            rel="noopener noreferrer nofollow"
        >
            Kliknij tutaj aby pobrać PDF
        </a>
    </div>
</object>

<style>
    .pdf-viewer {
        height: 100%;
        width: 100%;
    }

    .pdf-viewer__loading,
    .pdf-viewer__error {
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-jockey-one);
        font-size: var(--text-xl);
        letter-spacing: var(--tracking-wide);
    }

    .pdf-viewer__error {
        color: var(--color-red);
        text-align: center;
        padding: var(--space-4);
        display: grid;
        grid-template-columns: auto;
        grid-template-rows: 1fr auto 1fr;
        height: 100%;
        gap: 2rem;
    }

    .pdf-viewer__error-desc {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: end;
    }

    .pdf-viewer__error-btn {
        margin: 0 auto;
    }
</style>
