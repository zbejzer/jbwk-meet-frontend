---
import { Image } from 'astro:assets'

import MainLayout from '@layouts/MainLayout.astro'
import Header from '@components/Header.astro'
import BanerCover from '@components/BanerCover.astro'
import BanerOverlay from '@components/BanerOverlay.astro'
import SectionSeparator from '@components/SectionSeparator.astro'
import TextContainer from '@components/TextContainer.astro'
import Button from '@components/Button.astro'
import TopBaner from '@components/TopBaner.astro'

import bgPic1 from '@assets/index/bg-pic-1.webp'
import bgPic2 from '@assets/index/bg-pic-2.webp'
import bgPic3 from '@assets/index/bg-pic-3.webp'
import bgPic4 from '@assets/index/bg-pic-4.webp'
import replayFest from '@assets/index/replay_fest.jpg'
import bitBoat2026 from '@assets/index/bit-boat-2026.png'
---

<MainLayout>
    <Header />
    <TopBaner imageUrl={bgPic1} />
    <section>
        <SectionSeparator> O co tutaj chodzi? </SectionSeparator>
        <div class="my-14">
            <TextContainer>
                Od kilku lat organizujemy spotkania dla hobbystów, początkowo
                spotykaliśmy się w gronie znajomych, lecz rozwinęło się to do
                wiekszych spotkań. Chcemy dać możliwość społeczności na
                spotkanie się i spędzenie miło czasu, przy okazji organizując
                ciekawe konkursy dla urozmaicenia wydarzenia!
            </TextContainer>
        </div>
    </section>
    <section>
        <SectionSeparator backgroundColor="text-white bg-bit-boat-2026">
            Bit Boat 2026
        </SectionSeparator>
        <BanerCover imageUrl={bitBoat2026}>
            <Fragment>
                <p class="w-5/6 text-center text-xl/9 sm:text-start md:w-2/3">
                    Poza Meetem w tym roku można nas znaleźć również na Bit Boat
                    2026. Jako część interaktywnej wystawy z blisko 100 retro
                    stanowiskami do grania, będzie można obejrzeć i poklikąć
                    wycinek naszych kolekcji.
                </p>
                <div>
                    <a href="https://bitboat.pl/" target="_blank">
                        <Button backgroundColor="text-white bg-bit-boat-2026">
                            Strona Bit Boat 2026
                        </Button>
                    </a>
                </div>
            </Fragment>
        </BanerCover>
    </section>
    <section>
        <SectionSeparator> Grupa na Facebooku </SectionSeparator>
        <BanerOverlay imageUrl={bgPic4} align="justify-end">
            <Fragment>
                <p class="w-5/6 md:w-2/3">
                    Chciałbyś dowiedzieć się wiecej na temat klawiatur? A może
                    chciałbyś pochwalić się swoim buildem? Znajdziesz tam
                    informację o przyszłych wydarzeniach!
                </p>
                <div>
                    <a
                        href="https://www.facebook.com/groups/266901557998281/"
                        target="_blank"
                    >
                        <Button> Dołącz do naszej grupy na facebooku! </Button>
                    </a>
                </div>
            </Fragment>
        </BanerOverlay>
    </section>
</MainLayout>
